<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/fragment_holder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- We double trackThickness as half of it will be invisible -->
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/fabProgress"
            android:elevation="7dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:max="1"
            android:visibility="invisible"
            app:indicatorColor="?colorPrimary"
            app:layout_anchor="@+id/fab"
            app:layout_anchorGravity="center"
            app:layout_behavior="io.nekohasekai.sagernet.widget.FabProgressBehavior"
            app:trackCornerRadius="@dimen/mtrl_progress_track_thickness"
            app:trackThickness="8dp" />

        <io.nekohasekai.sagernet.widget.ServiceButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="6dp"
            android:nextFocusDown="@+id/stats"
            app:backgroundTint="?fabColorBackground"
            app:tint="?colorOnPrimaryContainer"
            app:layout_anchor="@id/stats"
            app:pressedTranslationZ="6dp"
            app:fabCustomSize="56dp"
            app:fabSize="normal"
            app:srcCompat="@drawable/ic_service_idle" />

        <io.nekohasekai.sagernet.widget.StatsBar
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:nextFocusUp="@+id/fab"
            app:backgroundTint="?colorSurfaceContainer"
            app:contentInsetStart="0dp"
            app:fabAlignmentMode="end"
            app:fabAnchorMode="embed"
            app:fabAlignmentModeEndMargin="16dp"
            app:removeEmbeddedFabElevation="false"
            app:hideOnScroll="false"
            app:layout_scrollFlags="enterAlways|scroll">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="80dp" android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground" android:orientation="vertical"
                android:paddingStart="16dp" android:paddingEnd="88dp" android:paddingVertical="12dp">
                <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:textAppearance="?textAppearanceLabelLarge" android:textColor="?colorOnSurface" />
                <TextView android:id="@+id/exit_ip" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp" android:visibility="gone" android:breakStrategy="simple"
                    android:textAppearance="?textAppearanceBodySmall" android:textColor="?colorPrimary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tx" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textAppearance="?textAppearanceLabelSmall" android:textColor="?colorOnSurfaceVariant" />
                    <TextView android:id="@+id/rx" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                        android:maxLines="1" android:ellipsize="end" android:textAppearance="?textAppearanceLabelSmall" android:textColor="?colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

        </io.nekohasekai.sagernet.widget.StatsBar>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        style="@style/Widget.Material3.NavigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/layout_drawer_header"
        app:menu="@menu/main_drawer_menu" />


</androidx.drawerlayout.widget.DrawerLayout>
