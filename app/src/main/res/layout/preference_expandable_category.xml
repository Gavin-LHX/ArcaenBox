<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="56dp" android:gravity="center_vertical"
    android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@android:id/title" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleSmall" android:textColor="?attr/colorPrimary" />
    <ImageView android:id="@+id/expand_arrow" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="16dp" android:src="@drawable/ic_expand_more" android:importantForAccessibility="no" />
</LinearLayout>
